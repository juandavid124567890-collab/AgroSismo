# Copia este archivo con el nombre ".env" (junto a manage.py) y pon tus valores reales.
# El archivo .env NUNCA se sube al repositorio (riesgo R-16). Aquí solo van ejemplos.
# Formato: NOMBRE=valor   (sin "$env:", sin comillas, una variable por línea)

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Para ver el sistema desde el celular agrega la IP del computador, por ejemplo:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.18.63
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL. Si DB_NAME no está definido se usa SQLite (solo pruebas).
DB_NAME=agrosismo
DB_USER=root
DB_PASSWORD=escribe-aqui-tu-clave-de-mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Solo en producción (servidor publicado) ---
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<clave larga y aleatoria, ver la guía>
# DJANGO_ALLOWED_HOSTS=usuario.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://usuario.pythonanywhere.com
